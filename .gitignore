# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# superpowers brainstorm sessions
.superpowers/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# agent worktrees: `git worktree add` under .claude/ puts a second full copy of the
# repo inside the repo. It was only ignored via .git/info/exclude, which is local and
# never leaves this machine, so a fresh clone had no protection at all.
.claude/worktrees/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
data/thames-water/*.pdf
